# ── server ───────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ── data source ──────────────────────────────────────────
# replay = real past races from OpenF1 (no credentials needed)
# live   = OpenF1 MQTT stream  (requires credentials below)
DATA_PROVIDER=replay

# Session to replay on boot. Leave blank to pick the most
# recent completed race automatically.
REPLAY_SESSION_KEY=
REPLAY_SPEED=1

# ── OpenF1 ───────────────────────────────────────────────
OPENF1_BASE_URL=https://api.openf1.org/v1
OPENF1_REQUESTS_PER_SECOND=2.5
OPENF1_TIMEOUT_MS=25000
OPENF1_CACHE_DIR=.cache/openf1

# Only needed when DATA_PROVIDER=live. Never commit real values.
OPENF1_USERNAME=
OPENF1_PASSWORD=

# ── replay tuning ────────────────────────────────────────
# Seconds of race time fetched per request while loading.
# Smaller = more requests, less memory per response.
LOAD_WINDOW_SECONDS=180
BROADCAST_HZ=10
